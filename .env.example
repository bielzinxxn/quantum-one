# QUANTUM ONE — modelo de configuração. NÃO coloque credenciais reais aqui.
# `make env` copia este arquivo para .env (permissão 600) e troca cada __generate__
# por um segredo aleatório forte. Os campos __placeholder__ você preenche à mão no .env.

# --- Geral ---
QONE_ENV=prod
LOG_LEVEL=INFO
IMAGE_TAG=dev
API_PORT=8000

# --- Modo de operação (backtest | paper | live) ---
# live exige LIVE_TRADING_ENABLED=true E sua liberação explícita por estratégia.
TRADING_MODE=backtest
LIVE_TRADING_ENABLED=false

# --- PostgreSQL (um papel por serviço) ---
POSTGRES_DB=quantum_one
POSTGRES_SUPERUSER_PASSWORD=__generate__
PG_MIGRATOR_PASSWORD=__generate__
PG_MARKETDATA_PASSWORD=__generate__
PG_ENGINE_PASSWORD=__generate__
PG_TRADER_PASSWORD=__generate__
PG_ACCOUNTING_PASSWORD=__generate__
PG_API_PASSWORD=__generate__

# --- Redis ---
REDIS_PASSWORD=__generate__

# --- Binance (a chave só vai para o serviço trader) ---
# Fase 3: chave SOMENTE LEITURA. Saque SEMPRE desabilitado. Restrinja ao IP da VPS.
# Recomendado: chave Ed25519. Cole a chave PRIVADA em PEM numa linha só, com \n literais:
#   BINANCE_API_SECRET="-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----"
# Com chave HMAC, cole o secret normalmente.
BINANCE_API_KEY=__placeholder__
BINANCE_API_SECRET=__placeholder__
# read_only (Fases 3–11) | trade (só live, exige TRADING_MODE=live)
BINANCE_KEY_POLICY=read_only
BINANCE_TESTNET=false
BINANCE_RECV_WINDOW_MS=5000
CLOCK_MAX_OFFSET_MS=1000
ACCOUNT_POLL_S=60

# --- Market Scanner (Fase 4) ---
# vazio = wss://stream.binance.com:9443 (doc oficial também lista wss://data-stream.binance.vision)
BINANCE_WS_URL=
SCANNER_UNIVERSE_SIZE=30
SCANNER_MIN_QUOTE_VOLUME=5000000
# pares sempre monitorados (se negociáveis), separados por vírgula
SCANNER_EXTRA_SYMBOLS=
SCANNER_STALE_AFTER_S=10
